generator clientJs {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model feedback {
  feedbackId       Int                @id @default(autoincrement()) @map("feedback_id")
  orderItemId      Int                @unique @map("order_item_id")
  memberId         Int                @map("member_id")
  rating           Int
  comment          String
  createdAt        DateTime           @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt        DateTime           @default(now()) @map("updated_at") @db.Timestamp(6)
  member           member             @relation(fields: [memberId], references: [memberId], onDelete: Cascade, onUpdate: NoAction, map: "fk_feedback_member")
  saleOrderItem    saleOrderItem      @relation(fields: [orderItemId], references: [orderItemId], onDelete: Cascade, onUpdate: NoAction, map: "fk_feedback_order_item")
  feedbackResponse feedbackResponse[]
  response         response[]

  @@index([memberId], map: "idx_feedback_member")
  @@index([orderItemId], map: "idx_feedback_order_item")
}

model feedbackResponse {
  responseId   Int      @id @default(autoincrement()) @map("response_id")
  feedbackId   Int      @map("feedback_id")
  memberId     Int      @map("member_id")
  responseText String   @map("response_text")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  feedback     feedback @relation(fields: [feedbackId], references: [feedbackId], onDelete: Cascade, onUpdate: NoAction, map: "fk_response_feedback")
  member       member   @relation(fields: [memberId], references: [memberId], onDelete: Cascade, onUpdate: NoAction, map: "fk_response_member")

  @@index([feedbackId], map: "idx_response_feedback")
  @@index([memberId], map: "idx_response_member")
  @@map("feedback_response")
}

model member {
  memberId         Int                @id @default(autoincrement()) @map("member_id")
  username         String             @unique @db.VarChar(50)
  email            String             @unique @db.VarChar(100)
  passwordHash     String             @map("password_hash") @db.VarChar(255)
  firstName        String             @map("first_name") @db.VarChar(50)
  lastName         String             @map("last_name") @db.VarChar(50)
  createdAt        DateTime?          @default(now()) @map("created_at") @db.Timestamp(6)
  feedback         feedback[]
  feedbackResponse feedbackResponse[]
  memberRole       memberRole[]
  response         response[]
  saleOrder        saleOrder[]
  cart             cart?
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model memberRole {
  memberId Int    @map("member_id")
  role     String @db.VarChar(20)
  member   member @relation(fields: [memberId], references: [memberId], onDelete: NoAction, onUpdate: NoAction)

  @@id([memberId, role])
  @@map("member_role")
}

model product {
  productId     Int             @id @default(autoincrement()) @map("product_id")
  name          String          @db.VarChar(100)
  description   String?
  price         Decimal         @db.Decimal(10, 2)
  category      String?         @db.VarChar(50)
  isAvailable   Boolean?        @default(true) @map("is_available")
  createdAt     DateTime?       @default(now()) @map("created_at") @db.Timestamp(6)
  saleOrderItem saleOrderItem[]
  cartItem      cartItem[]
  discountRule  discountRule[]
}

model response {
  responseId   Int       @id @default(autoincrement()) @map("response_id")
  feedbackId   Int       @map("feedback_id")
  memberId     Int       @map("member_id")
  responseText String    @map("response_text")
  createdAt    DateTime? @default(now()) @map("created_at") @db.Timestamp(6)
  feedback     feedback  @relation(fields: [feedbackId], references: [feedbackId], onDelete: Cascade, onUpdate: NoAction)
  member       member    @relation(fields: [memberId], references: [memberId], onDelete: NoAction, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model saleOrder {
  orderId         Int             @id @default(autoincrement()) @map("order_id")
  memberId        Int?            @map("member_id")
  orderDate       DateTime?       @default(now()) @map("order_date") @db.Timestamp(6)
  totalAmount     Decimal         @map("total_amount") @db.Decimal(10, 2)
  status          String          @db.VarChar(20)
  deliveryAddress String?         @map("delivery_address")
  member          member?         @relation(fields: [memberId], references: [memberId], onDelete: NoAction, onUpdate: NoAction)
  saleOrderItem   saleOrderItem[]

  @@map("sale_order")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model saleOrderItem {
  orderItemId Int        @id @default(autoincrement()) @map("order_item_id")
  orderId     Int?       @map("order_id")
  productId   Int?       @map("product_id")
  quantity    Int
  unitPrice   Decimal    @map("unit_price") @db.Decimal(10, 2)
  subtotal    Decimal    @db.Decimal(10, 2)
  feedback    feedback?
  saleOrder   saleOrder? @relation(fields: [orderId], references: [orderId], onDelete: NoAction, onUpdate: NoAction)
  product     product?   @relation(fields: [productId], references: [productId], onDelete: NoAction, onUpdate: NoAction)

  @@map("sale_order_item")
}

/// Discount rules stored in DB — no code changes needed to add new rules.
/// discountType: QUANTITY_PRODUCT | CART_VALUE | DELIVERY_TIERED | DELIVERY_FREE
/// QUANTITY_PRODUCT: productId required, thresholdValue = min qty, discountPercent = % off
/// CART_VALUE:       productId null,     thresholdValue = min subtotal $, discountPercent = % off
/// DELIVERY_TIERED:  productId null,     thresholdValue = lower-bound $, deliveryFee = fee
/// DELIVERY_FREE:    productId null,     thresholdValue = 0, overrides all tiered fees
model discountRule {
  ruleId          Int      @id @default(autoincrement()) @map("rule_id")
  discountType    String   @map("discount_type") @db.VarChar(30)
  thresholdValue  Decimal  @default(0) @map("threshold_value") @db.Decimal(10, 2)
  discountPercent Decimal  @default(0) @map("discount_percent") @db.Decimal(5, 2)
  deliveryFee     Decimal  @default(0) @map("delivery_fee") @db.Decimal(10, 2)
  productId       Int?     @map("product_id")
  isActive        Boolean  @default(true) @map("is_active")
  description     String?  @db.VarChar(255)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamp(6)

  product         product? @relation(fields: [productId], references: [productId], onDelete: SetNull, onUpdate: NoAction)

  @@map("discount_rule")
}

model cart {
  cartId    Int        @id @default(autoincrement()) @map("cart_id")
  memberId  Int        @unique @map("member_id")
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  member    member     @relation(fields: [memberId], references: [memberId], onDelete: Cascade, onUpdate: NoAction)
  cartItem  cartItem[]

  @@map("cart")
}

model cartItem {
  cartItemId Int      @id @default(autoincrement()) @map("cart_item_id")
  cartId     Int      @map("cart_id")
  productId  Int      @map("product_id")
  quantity   Int
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  cart       cart     @relation(fields: [cartId], references: [cartId], onDelete: Cascade, onUpdate: NoAction)
  product    product  @relation(fields: [productId], references: [productId], onDelete: NoAction, onUpdate: NoAction)

  @@unique([cartId, productId])
  @@index([cartId], map: "idx_cart_item_cart")
  @@index([productId], map: "idx_cart_item_product")
  @@map("cart_item")
}
